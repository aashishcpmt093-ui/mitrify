# Mitrify AI Gateway — environment variable NAMES with example settings.
# Put the real values only in the hosting dashboard (Render → mitrify service → Environment).
# Never commit real values to Git, and never put them in the app, the browser or a VITE_ variable.

# ── Switch on ──────────────────────────────────────────────────────────────────────────────────
MITRIFY_GATEWAY_ENABLED=1
MITRIFY_GATEWAY_HOST=gateway.mitrify.com

# The owner's code. Without it (or if shorter than 32 characters) no API key can be created and
# no admin action works. Make one with:  openssl rand -base64 36
MITRIFY_GATEWAY_SETUP_CODE=

# Daily spend limit in USD for all clients together. Unset = the gateway refuses all traffic.
MITRIFY_GATEWAY_DAILY_BUDGET_USD=2

# Render sits behind a proxy: use the X-Forwarded-For address for lockouts and the admin allowlist.
MITRIFY_GATEWAY_TRUST_PROXY=1
# Optional: only these addresses may use /admin (comma separated).
# MITRIFY_GATEWAY_ADMIN_IPS=

# Emergency stop without any database access: set to 1 and restart.
# MITRIFY_GATEWAY_KILL=1

# ── Surplus (first provider of the pilot) ──────────────────────────────────────────────────────
MITRIFY_SURPLUS_API_KEY=
# The OpenAI-compatible base URL from Surplus's official API docs (must be https://, ends before /chat/completions).
MITRIFY_SURPLUS_BASE_URL=
# Set to 1 only after you checked Surplus's terms allow this use (gateway / internal resale).
MITRIFY_SURPLUS_APPROVED=
# From Surplus's real concurrency limit for your account.
MITRIFY_SURPLUS_MAX_CONCURRENCY=4
MITRIFY_SURPLUS_MAX_QUEUE=50
# Optional active health probe path, only if Surplus documents one (for example /models).
# MITRIFY_SURPLUS_HEALTH_PATH=/models

# ── Later providers: same five variables each, left empty = not used ───────────────────────────
# MITRIFY_ROUTERONE_API_KEY=      MITRIFY_ROUTERONE_BASE_URL=      MITRIFY_ROUTERONE_APPROVED=
# MITRIFY_SILICONFLOW_API_KEY=    MITRIFY_SILICONFLOW_BASE_URL=    MITRIFY_SILICONFLOW_APPROVED=
# MITRIFY_DEEPINFRA_API_KEY=      MITRIFY_DEEPINFRA_BASE_URL=      MITRIFY_DEEPINFRA_APPROVED=
# MITRIFY_NOVITA_API_KEY=         MITRIFY_NOVITA_BASE_URL=         MITRIFY_NOVITA_APPROVED=

# ── Tuning (defaults shown) ────────────────────────────────────────────────────────────────────
# MITRIFY_GATEWAY_POOL_SIZE=10
# MITRIFY_GATEWAY_MAX_ATTEMPTS=2
# MITRIFY_GATEWAY_MAX_PRICE_AGE_DAYS=30
# MITRIFY_GATEWAY_MAX_BODY_BYTES=8388608
# MITRIFY_GATEWAY_MAX_INFLIGHT=200
# MITRIFY_GATEWAY_FIRST_BYTE_TIMEOUT_MS=120000
# MITRIFY_GATEWAY_IDLE_TIMEOUT_MS=120000
# MITRIFY_GATEWAY_TOTAL_TIMEOUT_MS=1800000
# MITRIFY_GATEWAY_QUEUE_TIMEOUT_MS=30000
# MITRIFY_GATEWAY_REQUIRE_STREAM_USAGE=1
# MITRIFY_GATEWAY_KEY_ROTATION_GRACE_HOURS=24

# ── Owner-only site (not the gateway) ──────────────────────────────────────────────────────────
# 1 = nobody can open any Mitrify page or API unless signed in as the admin. Off by default.
# Needs ADMIN_ID and ADMIN_PASSWORD (at least 10 characters) in the same settings.
# MITRIFY_ADMIN_ONLY=1
# ADMIN_ID=
# ADMIN_PASSWORD=
