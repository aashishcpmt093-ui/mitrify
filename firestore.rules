rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isDoctor() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == 'doctor';
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == 'staff';
    }

    function isStaffOrDoctor() {
      return isDoctor() || isStaff();
    }

    // Age is { days, months, years } so newborns (0 days) up to adults fit.
    function validAge(age) {
      return age is map
        && age.keys().hasOnly(['days','months','years'])
        && age.keys().hasAll(['days','months','years'])
        && age.days is number && age.days >= 0 && age.days <= 31
        && age.months is number && age.months >= 0 && age.months <= 11
        && age.years is number && age.years >= 0 && age.years <= 120;
    }

    // Users: each person can read their own profile; doctors manage all profiles (staff creation).
    // Clinic owner accounts may create their own doctor profile on first sign-in.
    // Keep in sync with OWNER_DOCTOR_EMAILS in client/src/lib/clinic.ts.
    function isOwnerEmail() {
      return signedIn() && request.auth.token.email in ['doc.asheesh@icloud.com', 'doc.asheesh@gmail.com'];
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isDoctor());
      allow create: if isDoctor()
        || (isOwnerEmail()
            && request.auth.uid == uid
            && request.resource.data.role == 'doctor'
            && request.resource.data.keys().hasOnly(['role', 'name', 'createdAt']));
      allow update, delete: if isDoctor();
    }

    // Patient entries.
    // - Public form (no login) may create only a "patient" entry with status "new".
    // - Staff may create entries tagged with their own uid.
    // - Doctors and staff may read; only doctors may change or delete.
    match /patients/{id} {
      allow create: if (
          !signedIn()
          && request.resource.data.source == 'patient'
          && request.resource.data.createdBy == null
          && request.resource.data.status == 'new'
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['name','age','address','parentName','mobile','weight','visitAt','source','createdBy','status','createdAt'])
          && request.resource.data.mobile is string && request.resource.data.mobile.matches('^[0-9]{10}$')
          && request.resource.data.name is string && request.resource.data.name.size() <= 120
          && request.resource.data.address is string && request.resource.data.address.size() <= 300
          && request.resource.data.parentName is string && request.resource.data.parentName.size() <= 120
          && request.resource.data.visitAt is string && request.resource.data.visitAt.size() <= 32
          && validAge(request.resource.data.age)
          && request.resource.data.weight is number && request.resource.data.weight > 0 && request.resource.data.weight <= 500
        ) || (
          isStaffOrDoctor()
          && request.resource.data.source == 'staff'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'new'
          && request.resource.data.createdAt == request.time
        );
      allow read: if isStaffOrDoctor();
      // Doctors may only change the status (to "prescribed") and nothing else.
      allow update: if isDoctor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isDoctor();
    }

    // Drug memory (names with their last form/dose/frequency): doctors only.
    match /drugs/{id} {
      allow read, write: if isDoctor();
    }

    // Diagnosis templates (usual medicines for a diagnosis): doctors only.
    match /templates/{id} {
      allow read, write: if isDoctor();
    }

    // Pad settings such as clinic timing: doctors only.
    match /settings/{id} {
      allow read, write: if isDoctor();
    }

    // Prescriptions: doctors only.
    match /prescriptions/{id} {
      allow read, create: if isDoctor();
      allow update, delete: if false;
    }
  }
}
