rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isDoctor() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == 'doctor';
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == 'staff';
    }

    function isStaffOrDoctor() {
      return isDoctor() || isStaff();
    }

    function validAge(age) {
      return age is map
        && age.keys().hasOnly(['days','months','years'])
        && age.keys().hasAll(['days','months','years'])
        && age.days is number && age.days >= 0 && age.days <= 31
        && age.months is number && age.months >= 0 && age.months <= 11
        && age.years is number && age.years >= 0 && age.years <= 120;
    }

    function isOwnerEmail() {
      return signedIn() && request.auth.token.email in ['doc.asheesh@icloud.com', 'doc.asheesh@gmail.com'];
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isDoctor());
      allow create: if isDoctor()
        || (isOwnerEmail()
            && request.auth.uid == uid
            && request.resource.data.role == 'doctor'
            && request.resource.data.keys().hasOnly(['role', 'name', 'createdAt']));
      allow update, delete: if isDoctor();
    }

    match /patients/{id} {
      allow create: if (
          !signedIn()
          && request.resource.data.source == 'patient'
          && request.resource.data.createdBy == null
          && request.resource.data.status == 'new'
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['name','age','address','parentName','mobile','weight','visitAt','source','createdBy','status','createdAt'])
          && request.resource.data.mobile is string && request.resource.data.mobile.matches('^[0-9]{10}$')
          && request.resource.data.name is string && request.resource.data.name.size() <= 120
          && request.resource.data.address is string && request.resource.data.address.size() <= 300
          && request.resource.data.parentName is string && request.resource.data.parentName.size() <= 120
          && request.resource.data.visitAt is string && request.resource.data.visitAt.size() <= 32
          && validAge(request.resource.data.age)
          && request.resource.data.weight is number && request.resource.data.weight > 0 && request.resource.data.weight <= 500
        ) || (
          isStaffOrDoctor()
          && request.resource.data.source == 'staff'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'new'
          && request.resource.data.createdAt == request.time
        );
      allow read: if isStaffOrDoctor();
      allow update: if isDoctor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isDoctor();
    }

    match /drugs/{id} {
      allow read, write: if isDoctor();
    }

    match /templates/{id} {
      allow read, write: if isDoctor();
    }

    // settings/pad holds the clinic name and pad details, shown on the public patient page too.
    match /settings/{id} {
      allow read: if id == 'pad' || isDoctor();
      allow write: if isDoctor();
    }

    match /prescriptions/{id} {
      allow read, create: if isDoctor();
      allow update, delete: if false;
    }
  }
}
